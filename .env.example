# InfraSage Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is listed in .gitignore and will never be committed to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama (LLM) ─────────────────────────────────────────────────────────────
# URL where the Ollama server is running (native macOS process, NOT in Docker).
INFRASAGE_OLLAMA_URL=http://localhost:11434

# The model to use for Terraform HCL generation.
# qwen2.5-coder:3b is the recommended model for M2 / 8 GB RAM.
# Pull it with: infrasage model pull  (or: ollama pull qwen2.5-coder:3b)
INFRASAGE_OLLAMA_MODEL=qwen2.5-coder:3b

# Inference timeout in seconds. 120s is sufficient for qwen2.5-coder:3b on M2.
# Increase only if you switch to a larger model.
INFRASAGE_OLLAMA_TIMEOUT=120s

# ── Scanner ───────────────────────────────────────────────────────────────────
# Host directory mounted into scanner containers as /scans.
# Must be writable. Created automatically by 'infrasage stack up'.
INFRASAGE_SCAN_DIR=/tmp/infrasage-scans

# ── Docker Compose ────────────────────────────────────────────────────────────
# Path to the docker-compose.yml used by 'infrasage stack' commands.
# Change this if you move the deploy/ directory.
INFRASAGE_COMPOSE_FILE=./deploy/docker-compose.yml

# ── UI ────────────────────────────────────────────────────────────────────────
# Port used by the InfraSage UI dashboard.
INFRASAGE_UI_PORT=3000

# ── Monitoring ────────────────────────────────────────────────────────────────
# Port on which the CLI binary exposes its Prometheus /metrics endpoint.
# Must match the scrape target in deploy/prometheus.yml.
INFRASAGE_METRICS_PORT=2112

# URL of the Grafana instance started by 'infrasage stack up'.
INFRASAGE_GRAFANA_URL=http://localhost:3001

# ── GitHub (required for 'infrasage deploy') ──────────────────────────────────
# Personal access token with 'repo' scope.
# Create one at: https://github.com/settings/tokens/new
# Required scopes: repo (Full control of private repositories)
GITHUB_TOKEN=

# Repository in owner/repo format (e.g. Sahil0114/infrasage1).
GITHUB_REPO=Sahil0114/infrasage1

# The base branch that pull requests are opened against.
GITHUB_DEFAULT_BRANCH=main

# ── AWS (used by terraform apply / drift commands) ────────────────────────────
# These are referenced by the Terraform AWS provider.
# Alternatively, configure via AWS CLI: aws configure
# Or use AWS SSO: aws sso login --profile <profile>
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
